#   - Twilio (https://www.twilio.com)
#   - Msg91 (https://msg91.com)
# then fill these in and wire them up in src/routes/auth.js where marked
# TODO: SEND REAL SMS.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=KarachiWale
