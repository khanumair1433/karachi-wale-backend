# Copy this file to .env and fill in real values before deploying.

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# --- SMS / OTP provider ---
# This starter logs the OTP to the server console instead of sending a real
# text message, so you can develop without paying for SMS credits.
